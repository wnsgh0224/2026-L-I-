#include <Arduino.h>
#include <math.h>

// 드론 고유 정보
const int DRONE_ID = 0;       // 드론 A는 0, 드론 B는 1 (총 2대 예시)
const int TOTAL_DRONES = 2;   // 전체 드론 수

// 충전소(기준점) 위치
const double BASE_LAT = 36.3504;
const double BASE_LON = 127.3845;

// 부채꼴 정찰 설정
const double SEARCH_RADIUS = 500.0; // 탐색 거리 (500미터)
const double CENTER_BEARING = 0.0;  // 정찰 중심 방향 (0도 = 북쪽, 90도 = 동쪽)
const double FAN_ANGLE = 90.0;       // 부채꼴 펼침 각도 (90도 폭)

// 목표 좌표 저장 변수
double targetLat = 0.0;
double targetLon = 0.0;

// degree -> radian 변환
double deg2rad(double deg) {
  return deg * (M_PI / 180.0);
}

// 부채꼴 목적지 좌표 계산 함수
void calculateFanTarget(int droneIndex, int totalDrones) {
  double startAngle = CENTER_BEARING - (FAN_ANGLE / 2.0);
  double angleStep = (totalDrones > 1) ? (FAN_ANGLE / (totalDrones - 1)) : 0;
 
  // 현재 드론에 할당된 방위각 (Degree)
  double myBearing = startAngle + (angleStep * droneIndex);
  double radBearing = deg2rad(myBearing);

  // 위도/경도 1도당 미터 단위 환산 (대략적 계산)
  double metersPerLat = 111000.0;
  double metersPerLon = 111000.0 * cos(deg2rad(BASE_LAT));

  // 거리와 각도를 반영한 오프셋 계산 (미터 -> 위경도)
  double deltaLat = (SEARCH_RADIUS * cos(radBearing)) / metersPerLat;
  double deltaLon = (SEARCH_RADIUS * sin(radBearing)) / metersPerLon;

  targetLat = BASE_LAT + deltaLat;
  targetLon = BASE_LON + deltaLon;

  Serial.print("드론 "); Serial.print(droneIndex);
  Serial.print(" 할당 방위각: "); Serial.print(myBearing); Serial.println("도");
  Serial.print("목표 위도: "); Serial.println(targetLat, 6);
  Serial.print("목표 경도: "); Serial.println(targetLon, 6);
}

void setup() {
  Serial.begin(9600);
  Serial.println("드론 산개 제어 시스템 준비 완료");
}

void loop() {
  // 예시: 무전기나 통신으로 "FAN_OUT" 명령을 받았다고 가정
  if (Serial.available()) {
    String cmd = Serial.readStringUntil('\n');
    cmd.trim();

    if (cmd == "FAN_OUT") {
      Serial.println("\n[명령 발생] 부채꼴 산개 비행을 시작합니다!");
     
      // 내 드론 ID 기반 부채꼴 목표 좌표 계산
      calculateFanTarget(DRONE_ID, TOTAL_DRONES);
     
      // MAVLink 명령이나 FC 제어를 시작하여 (targetLat, targetLon)으로 이동
      // flyToTarget(targetLat, targetLon);
    }
  }
}
