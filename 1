#include <TinyGPS++.h>
#include <SoftwareSerial.h>

// 통신 및 GPS 설정 (예: XBee 통신 모듈, GPS 모듈)
SoftwareSerial Radio(10, 11); // RX, TX (다른 드론과 통신)
SoftwareSerial GPS_Serial(4, 5); // RX, TX (GPS)
TinyGPSPlus gps;

// 핀 설정
const int BATTERY_PIN = A0;
const float LOW_BATTERY_THRESHOLD = 20.0; // 배터리 20% 이하일 때 복귀

// 충전소(Box) GPS 좌표
const float BOX_LAT = 36.3504; // 예시 위도
const float BOX_LON = 127.3845; // 예시 경도

// 드론 상태 정의
enum DroneState {
  STANDBY,       // 박스에서 대기 중 (충전 중)
  ON_MISSION,    // 임무 수행 중 (비행 중)
  RETURNING      // 배터리 부족으로 복귀 중
};

DroneState currentState = STANDBY; // 초기 상태 설정 (필요에 따라 변경)

// 현재 위치 저장용 변수
float currentLat = 0.0;
float currentLon = 0.0;

void setup() {
  Serial.begin(9600);
  Radio.begin(9600);
  GPS_Serial.begin(9600);
 
  Serial.println("드론 시스템 초기화 완료");
}

void loop() {
  // 1. GPS 위치 업데이트
  while (GPS_Serial.available() > 0) {
    gps.encode(GPS_Serial.read());
    if (gps.location.isUpdated()) {
      currentLat = gps.location.lat();
      currentLon = gps.location.lng();
    }
  }

  // 2. 배터리 잔량 확인 (전압 분배 회로 사용 가정)
  int sensorValue = analogRead(BATTERY_PIN);
  float voltage = sensorValue * (5.0 / 1023.0);
  float batteryPercent = map(voltage, 3.2, 4.2, 0, 100); // 1셀 LiPo 기준 예시

  // 3. 상태에 따른 행동 로직 (State Machine)
  switch (currentState) {
   
    case ON_MISSION:
      // 배터리가 떨어지면 교대 요청 후 복귀
      if (batteryPercent <= LOW_BATTERY_THRESHOLD) {
        Serial.println("경고: 배터리 부족! 교대 드론 호출...");
       
        // 대기 중인 드론에게 현재 위치 전송 ("REPLACE,위도,경도")
        Radio.print("REPLACE,");
        Radio.print(currentLat, 6);
        Radio.print(",");
        Radio.println(currentLon, 6);
       
        currentState = RETURNING;
      }
      break;

    case RETURNING:
      // 충전소(Box)로 이동하는 로직 (실제로는 MAVLink 등을 통해 비행 컨트롤러에 명령 전달)
      flyTo(BOX_LAT, BOX_LON);
     
      // 박스에 도착하면 상태를 대기(충전)로 변경
      if (isArrived(BOX_LAT, BOX_LON)) {
        currentState = STANDBY;
        Serial.println("충전소 도착. 충전 시작 및 대기 모드 전환.");
      }
      break;

    case STANDBY:
      // 무전기로부터 교대 요청(REPLACE) 신호가 오는지 확인
      if (Radio.available()) {
        String msg = Radio.readStringUntil('\n');
       
        if (msg.startsWith("REPLACE")) {
          // 메시지 파싱하여 목표 위치 추출
          int firstComma = msg.indexOf(',');
          int secondComma = msg.indexOf(',', firstComma + 1);
         
          float targetLat = msg.substring(firstComma + 1, secondComma).toFloat();
          float targetLon = msg.substring(secondComma + 1).toFloat();
         
          Serial.println("교대 요청 수신! 해당 위치로 출동합니다.");
         
          // 목표 위치로 비행 후 임무 상태로 전환
          flyTo(targetLat, targetLon);
          currentState = ON_MISSION;
        }
      }
      break;
  }
}

